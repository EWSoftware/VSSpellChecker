		<Description>This assembly contains interfaces and other supporting classes used to implement a spell checker for Visual Studio</Description>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<Configurations>Debug;Release</Configurations>
		<NoWarn>NU1701,NU1702</NoWarn>
	</PropertyGroup>

