<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<AssemblyName>VisualStudio.SpellChecker.Common</AssemblyName>
		<RootNamespace>VisualStudio.SpellChecker.Common</RootNamespace>
